{
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "source": "/api/pdfs/(?<name>.*)", "destination": "/api/pdfs/[name].py" },
    { "source": "/api/(.*)", "destination": "/api/$1.py" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
